---
import raw from '../assets/eagle.svg?raw';
interface Props { class?: string; label?: string }
const { class: cls = '', label } = Astro.props;
const svg = raw.replace('<svg ', `<svg class="eagle ${cls}" ${label ? `role="img" aria-label="${label}"` : 'aria-hidden="true"'} `);
---
<Fragment set:html={svg} />
