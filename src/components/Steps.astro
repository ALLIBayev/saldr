---
import { t, type Lang } from '../i18n';
interface Props { lang: Lang }
const s = t(Astro.props.lang).process.steps;
---
<ol class="steps">
  {s.map(([title, when, p], i) => (
    <li class="step"><span class="step__n">{String(i + 1).padStart(2, '0')}</span><h3>{title}</h3><p class="step__t">{when}</p><p>{p}</p></li>
  ))}
</ol>
