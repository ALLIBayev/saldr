---
import Shot from './Shot.astro';
import EagleStage from './EagleStage.astro';
import { t, type Lang } from '../i18n';
interface Props { k: string; active?: boolean; lang: Lang }
const { k, active = false, lang } = Astro.props;
const C = t(lang).chat;
const a = active ? ' is-active' : '';
---
{k === 'web' && <div class={`svc__vis svc__vis--web${a}`} data-vis="web"><div class="browser"><div class="browser__bar"><i></i><i></i><i></i><span></span></div><Shot name="layl-1" widths={[720, 1080]} sizes="(min-width: 900px) 40vw, 80vw" /></div></div>}
{k === 'app' && <div class={`svc__vis svc__vis--app${a}`} data-vis="app"><div class="phone"><Shot name="ci-m" widths={[390]} sizes="250px" /></div><div class="phone"><Shot name="sp-m" widths={[390]} sizes="200px" /></div></div>}
{k === 'brand' && <div class={`svc__vis svc__vis--brand${a}`} data-vis="brand"><EagleStage labels={false} /></div>}
{k === 'ai' && (
  <div class={`svc__vis svc__vis--ai${a}`} data-vis="ai"><div class="chat">
    <div class="bub bub--me">{C[0]}<small>21:47</small></div>
    <div class="bub bub--bot">{C[1]}<small>21:47 · {C[3]}</small></div>
    <div class="bub bub--me">{C[2]}<small>21:48</small></div>
    <div class="bub bub--bot"><span class="typing"><i></i><i></i><i></i></span></div>
  </div></div>
)}
