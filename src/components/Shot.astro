---
import { Picture } from 'astro:assets';
import { img } from '../data/cases';
interface Props { name: string; alt?: string; widths?: number[]; sizes?: string; eager?: boolean; class?: string }
const { name, alt = '', widths = [640, 960, 1440], sizes = '(min-width: 1360px) 1248px, 92vw', eager = false, class: cls } = Astro.props;
const src = img(name);
const ws = widths.filter((w) => w <= src.width).concat(widths.some((w) => w > src.width) ? [src.width] : []);
---
<Picture src={src} alt={alt} formats={['avif', 'webp']} widths={[...new Set(ws)]} sizes={sizes} quality={72}
  loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" class={cls} />
