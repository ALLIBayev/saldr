---
import { t, L, type Lang } from '../i18n';
interface Props { id: string; lang: Lang }
const { id, lang } = Astro.props;
const F = t(lang).form;
const roll = (s: string) => `<span class="roll"><span>${s}</span><span aria-hidden="true">${s}</span></span>`;
---
<form class="form js-form" novalidate>
  <div class="field" data-req>
    <label for={`${id}-name`}>{F.name}</label>
    <input id={`${id}-name`} name="name" autocomplete="name" required />
    <span class="err">{F.nameErr}</span>
  </div>
  <div class="field" data-req>
    <label for={`${id}-contact`}>{F.contact}</label>
    <input id={`${id}-contact`} name="contact" autocomplete="email" required />
    <span class="err">{F.contactErr}</span>
  </div>
  <div class="field"><fieldset><legend>{F.what}</legend>
    <div class="chips">
      {F.whatOpts.map((v) => (
        <label class="chip"><input type="checkbox" name="what" value={v} /><span>{v}</span></label>
      ))}
    </div></fieldset></div>
  <div class="field"><fieldset><legend>{F.budget}</legend>
    <div class="chips">
      {F.budgetOpts.map((v) => (
        <label class="chip"><input type="radio" name="budget" value={v} /><span>{v}</span></label>
      ))}
    </div></fieldset></div>
  <div class="field" data-req>
    <label for={`${id}-msg`}>{F.msg}</label>
    <textarea id={`${id}-msg`} name="message" rows="4" required></textarea>
    <span class="hint">{F.msgHint}</span>
    <span class="err">{F.msgErr}</span>
  </div>
  <div class="form__foot">
    <button class="btn btn--ink" type="submit" set:html={roll(F.submit)} />
    <p class="small">{F.note} <a class="link-u" href={L(lang, 'privacy')}>{F.privacyLink}</a></p>
  </div>
</form>
<div class="done" role="status">
  <h3 class="h3" tabindex="-1">{F.doneTitle}</h3>
  <p class="muted">{F.doneText}</p>
  <div class="done__box"></div>
  <div class="done__actions">
    <a class="btn btn--primary btn--sm done__tg" href="https://t.me/wcinreak" target="_blank" rel="noopener" set:html={roll(F.send)} />
    <a class="btn btn--ghost btn--sm done__wa" href="https://wa.me/393520881131" target="_blank" rel="noopener" set:html={roll('WhatsApp')} />
    <button class="btn btn--ghost btn--sm done__copy" type="button" set:html={roll(F.copy)} />
    <button class="btn btn--ghost btn--sm done__back" type="button">{F.edit}</button>
  </div>
</div>
