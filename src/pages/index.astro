---
import Base from '../layouts/Base.astro';
import Btn from '../components/Btn.astro';
import Shot from '../components/Shot.astro';
import EagleStage from '../components/EagleStage.astro';
import SvcVis from '../components/SvcVis.astro';
import Steps from '../components/Steps.astro';
import Cta from '../components/Cta.astro';
import { CASES } from '../data/cases';
import { u } from '../data/site';

const reel: [string, 'd' | 'm', string][] = [
  ['layl-1', 'd', 'LAYL store, home page'], ['cv-m', 'm', 'ConVoglio on a phone'], ['ci-1', 'd', 'USPR Cirillico page'],
  ['layl-m', 'm', 'LAYL on a phone'], ['sp-1', 'd', 'San Paolo Torino home page'], ['cv-2', 'd', 'ConVoglio about section'],
  ['ci-m', 'm', 'Cirillico on a phone'], ['layl-2', 'd', 'LAYL collection grid'], ['sp-m', 'm', 'San Paolo on a phone'],
];
const services = [
  ['web', 'Websites & landing pages', 'Fast, search-friendly sites that load in under a second and turn visits into enquiries.', ['Landing pages', 'Company websites', 'Online stores', 'Multilingual sites', 'SEO & analytics', 'Hosting & care']],
  ['app', 'Apps & digital products', 'Web and mobile apps, from the first clickable prototype to a version real people pay for.', ['Product design', 'UI/UX & prototypes', 'Web apps', 'Mobile apps', 'Dashboards', 'Design systems']],
  ['brand', 'Brand identity', 'A name, a mark, type and colour that hold up on a phone screen, a hoodie and a shop sign.', ['Naming', 'Logo & mark', 'Visual identity', 'Brand guidelines', 'Merch & packaging', 'Social templates']],
  ['ai', 'AI & automation', 'Bots and workflows that take orders, answer questions and book appointments while you sleep.', ['WhatsApp & Telegram bots', 'Chat assistants', 'Booking automation', 'CRM & sheets sync', 'AI features in apps', 'Internal tools']],
] as const;
---
<Base title="Saldr Studio — Design & development studio in Turin" description="Independent design and development studio in Turin. Websites, apps, brand identity and AI automation by Alizhan “Don” Saldyrbayev.">
  <section class="hero">
    <div class="wrap grid hero__grid">
      <div class="hero__copy">
        <p class="hero__status"><i aria-hidden="true"></i>Open for new projects</p>
        <h1 class="h-hero">Sites, apps and brands built to scale.</h1>
        <p class="lead hero__sub">Saldr is the independent studio of <strong>Alizhan “Don” Saldyrbayev</strong> in Turin. I design and build websites, apps, brand identities and AI automation — one person from first sketch to launch, so nothing gets lost in a handoff.</p>
        <div class="hero__cta"><Btn label="Start a project" drawer /><Btn label="See the work" variant="ghost" href={u('work')} /></div>
      </div>
      <div class="hero__mark"><EagleStage /></div>
    </div>
    <div class="hero__meta"><div class="wrap"><span><b>Turin, Italy</b> — <span data-clock>--:--</span> local time</span><span>Working in English, Italiano, Русский, Қазақша</span><span>Scroll to explore</span></div></div>
  </section>

  <section class="reel" aria-label="Recent screens" data-cursor="Drag">
    <div class="reel__track">
      {[0, 1].map((dup) => reel.map(([n, k, a]) => (
        <div class={`reel__item${k === 'm' ? ' reel__item--m' : ''}`} aria-hidden={dup ? 'true' : undefined}>
          <Shot name={n} alt={dup ? '' : a} widths={k === 'm' ? [390] : [760, 1440]} sizes={k === 'm' ? '230px' : '(min-width: 900px) 760px, 420px'} />
        </div>
      )))}
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="manifesto" data-scrub>
        <p>In Kazakhstan, a berkutchi spends years training a golden eagle before its first hunt. From the sky it reads the whole steppe. When it finally drops, it doesn’t miss.</p>
        <p>That’s how I work. See the whole product first — your customers, your numbers, your next year. Then drop on the details that make it scale.</p>
      </div>
      <div class="sig">
        <svg viewBox="0 0 150 64" data-draw aria-hidden="true"><path d="M14 12 C13 24 11 38 9 51"/><path d="M6 15 C30 6 54 18 50 36 C46 52 24 56 6 50"/><path d="M68 37 C60 36 57 50 66 51 C75 52 77 38 68 37 Z"/><path d="M84 51 C85 45 85 41 87 38 C91 33 99 35 99 43 L99 51 C104 55 122 43 146 33"/></svg>
        <p><b>Alizhan “Don” Saldyrbayev</b>Founder, designer and developer</p>
      </div>
    </div>
  </section>

  <section class="sec" style="padding-top:0">
    <div class="wrap">
      <div class="shead"><h2 class="h2" data-split>Selected work</h2><Btn label="All projects" variant="ghost" small magnetic={false} href={u('work')} /></div>
      <div class="stack">
        {CASES.map((c) => (
          <a class="case" href={u(`work/${c.slug}`)} data-cursor="View">
            <div class="case__info"><div><p class="case__name">{c.name} · {c.year}</p><h3 class="case__title" data-blur>{c.short}</h3></div><div class="case__tags">{c.tags.map((t) => <span class="tag">{t}</span>)}</div></div>
            <div class="case__frame"><Shot name={c.imgs[0]} alt={`${c.name} — ${c.short}`} /><div class="case__phone"><Shot name={c.mob} widths={[390]} sizes="230px" /></div></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="sec dark" data-theme="dark" id="services">
    <div class="wrap">
      <div class="shead"><h2 class="h2" data-split>What I make</h2><p>Four disciplines under one roof, so your site, app and brand speak with one voice.</p></div>
      <div class="svc">
        <div class="svc__list">
          {services.map(([k, t, p, items]) => (
            <div class="svc__item" data-vis={k}><h3>{t}</h3><p>{p}</p><ul>{items.map((i) => <li>{i}</li>)}</ul>
              <div class="svc__vis-inline" aria-hidden="true"><SvcVis k={k} active /></div></div>
          ))}
        </div>
        <div class="svc__media"><div class="svc__stage"><SvcVis k="web" active /><SvcVis k="app" /><SvcVis k="brand" /><SvcVis k="ai" /></div></div>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="shead"><h2 class="h2" data-split>How a project runs</h2><p>Clear steps, a fixed price and a live preview link from the first week.</p></div>
      <Steps />
    </div>
  </section>

  <section class="langs" aria-label="Languages">
    <div class="langs__track" aria-hidden="true">{[...Array(2)].flatMap(() => ['Hello', 'Ciao', 'Привет', 'Сәлем', 'Hola', 'Bonjour']).map((w) => <span>{w}</span>)}</div>
    <div class="wrap langs__cap"><span>Sites in your customers’ language.</span><span>LAYL ships in nine. Cirillico in three.</span></div>
  </section>

  <section class="sec">
    <div class="wrap founder">
      <div>
        <h2 class="h2" data-split>One founder. Zero handoffs.</h2>
        <p class="lead">The person on your first call is the one who designs the screens, writes the code and ships your product. Kazakh-born, Turin-based, and picky about details most people never notice.</p>
        <Btn label="Read the story" variant="ink" href={u('studio')} />
      </div>
      <div class="founder__card" data-cursor="Hi">
        <svg class="cons-art" viewBox="0 0 400 460" aria-hidden="true" data-draw><g fill="none" stroke="#16181D" stroke-opacity=".12" stroke-width="1"><circle cx="200" cy="250" r="150"/><circle cx="200" cy="250" r="95"/><path d="M0 250H400M200 0V460M60 110 340 390M340 110 60 390"/></g></svg>
        <div class="founder__coords"><span>45.07° N</span><span>7.69° E</span></div>
        <div class="founder__big">Don.</div>
        <div class="founder__coords"><span>Saldr Studio</span><span>Turin</span></div>
      </div>
    </div>
  </section>

  <Cta title="Have something to make?" text="Send a short brief. You’ll get a free first screen of your project within 48 hours." />
</Base>
