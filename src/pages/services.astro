---
import Base from '../layouts/Base.astro';
import Btn from '../components/Btn.astro';
import Steps from '../components/Steps.astro';
import Cta from '../components/Cta.astro';
const blocks = [
  ['Websites & landing pages', '1–4 weeks', 'Sites that load fast, rank in search and make the next step obvious. Built mobile-first, in as many languages as your customers speak.', [['Landing pages', '1–2 wks'], ['Company websites', '3–4 wks'], ['Online stores', '3–5 wks'], ['Multilingual setup', 'add-on'], ['SEO, analytics, speed', 'included'], ['Hosting & domain setup', 'included']]],
  ['Apps & digital products', '4–10 weeks', 'From a clickable prototype you can test with users, to a web or mobile app that handles real accounts, payments and data.', [['Product discovery', '1 wk'], ['UI/UX & prototype', '2–3 wks'], ['Web app (React / Next.js / Astro)', '4+ wks'], ['Mobile app', '6+ wks'], ['Dashboards & admin', 'add-on'], ['Design system', 'add-on']]],
  ['Brand identity', '2–3 weeks', 'A mark, a palette and type that work everywhere you show up — website, social, packaging, a sign above the door.', [['Naming', '1 wk'], ['Logo & mark', '1–2 wks'], ['Colour & type system', 'included'], ['Brand guidelines', 'included'], ['Social templates', 'add-on'], ['Merch & packaging', 'add-on']]],
  ['AI & automation', '1–3 weeks', 'The repetitive part of your day, handled. Bots that answer customers, take orders and bookings, and keep your sheets and CRM in sync.', [['WhatsApp & Telegram bots', '1–2 wks'], ['Website chat assistant', '1–2 wks'], ['Booking & order flows', '1 wk'], ['CRM / Sheets sync', '1 wk'], ['AI features in your app', 'custom'], ['Internal tools', 'custom']]],
] as const;
const plans = [
  ['Launch', 'A product, event or offer that needs one sharp page.', '1–2', 'weeks', ['One landing page', 'Copy help and structure', 'Contact or booking form', 'Analytics and SEO basics'], false],
  ['Presence', 'A business that needs a proper site and a look to match.', '3–4', 'weeks', ['Up to 6 pages', 'Logo refresh or new mark', 'Two languages', 'Content updates for a month'], true],
  ['Product', 'A startup or team building an app or platform.', '6+', 'weeks', ['Discovery and prototype', 'Web or mobile app', 'Admin and dashboards', 'Launch support'], false],
  ['Care', 'Anything already live that should stay fast and fresh.', 'Monthly', '', ['Hosting and backups', 'Small changes each month', 'Speed and SEO checks', 'Priority fixes'], false],
] as const;
const faqs = [
  ['How much does a project cost?', 'Every project gets a fixed price after a 15-minute call, so you know the total before anything starts. You pay 50% to begin and 50% at launch. Small landing pages start in the low thousands of euros; apps cost more because they do more.'],
  ['How long will it take?', 'A landing page takes one to two weeks, a full website three to four, an app six weeks or more. You see progress on a live preview link from the first week.'],
  ['Who owns the result?', 'You do. The code, the designs, the domain and every account are in your name once the final payment is made.'],
  ['Do you work with clients outside Italy?', 'Yes. I work in English, Italian, Russian and Kazakh, and most of the process happens online — calls, a shared preview link and messages.'],
  ['Can you work with my existing brand?', 'Yes. I can build on your current logo and colours, refresh them, or design a new identity if the old one is holding you back.'],
  ['What happens after launch?', 'I stay on for a month of fixes at no cost. After that you can join the Care plan or ask for changes whenever you need them.'],
];
---
<Base title="Services — Saldr Studio" description="Websites, apps, brand identity and AI automation. Fixed prices, clear timelines." active="services">
  <section class="phero"><div class="wrap"><div class="phero__row">
    <h1 class="h1" data-split style="max-width:12ch">Four things, done properly.</h1>
    <p class="lead" data-fade>Websites, apps, brand identity and AI automation. Pick one, or let them work together.</p>
  </div></div></section>
  <section class="sec" style="padding-top:0"><div class="wrap">
    {blocks.map(([t, d, p, items]) => (
      <div class="sblock"><div class="sblock__head"><h2 data-split>{t}</h2><p>Typical timeline: {d}</p></div>
        <div class="sblock__body"><p>{p}</p><ul>{items.map(([a, b]) => <li>{a}<span>{b}</span></li>)}</ul></div></div>
    ))}
  </div></section>
  <section class="sec dark" data-theme="dark"><div class="wrap">
    <div class="shead"><h2 class="h2" data-split>Ways to work together</h2><p>Every project gets a fixed quote after a short call. No hourly surprises.</p></div>
    <div class="plans" style="color:var(--ink)">
      {plans.map(([n, f, t, unit, li, feat]) => (
        <div class={`plan${feat ? ' plan--feat' : ''}`}>
          {feat && <span class="tag tag--dark plan__flag">Most chosen</span>}
          <h3>{n}</h3><p class="plan__for">{f}</p>
          <p class="plan__time">{t}<small>{unit ? `${unit} · fixed quote after the call` : 'plan · cancel any time'}</small></p>
          <ul>{li.map((x) => <li>{x}</li>)}</ul>
          <Btn label={`Ask about ${n}`} variant={feat ? 'light' : 'ghost'} small drawer magnetic={false} />
        </div>
      ))}
    </div>
  </div></section>
  <section class="sec"><div class="wrap"><div class="shead"><h2 class="h2" data-split>How a project runs</h2></div><Steps /></div></section>
  <section class="sec" style="padding-top:0"><div class="wrap">
    <div class="shead"><h2 class="h2" data-split>Questions</h2><p>Something else on your mind? Ask it in your brief.</p></div>
    <div class="faq">{faqs.map(([q, a]) => <details><summary>{q}<i aria-hidden="true"></i></summary><div class="faq__a"><p>{a}</p></div></details>)}</div>
  </div></section>
  <Cta title="Let’s scope it in 15 minutes." text="Send a short brief and we’ll pick a time that suits you." />
</Base>
