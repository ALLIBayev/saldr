---
import Base from '../../layouts/Base.astro';
import Shot from '../../components/Shot.astro';
import { CASES } from '../../data/cases';
import { u } from '../../data/site';
export function getStaticPaths() {
  return CASES.map((c, i) => ({ params: { slug: c.slug }, props: { c, next: CASES[(i + 1) % CASES.length] } }));
}
const { c, next } = Astro.props;
---
<Base title={`${c.name} — Saldr Studio`} description={`${c.name}: ${c.short}. Case study by Saldr Studio.`} active="work">
  <section class="phero"><div class="wrap">
    <div class="phero__kicker" data-fade>{c.tags.map((t) => <span class="tag">{t}</span>)}</div>
    <h1 class="h1" data-split style="max-width:18ch">{c.title}</h1>
    <dl class="cmeta" data-fade>
      <div><dt>Client</dt><dd>{c.client}</dd></div>
      <div><dt>Year</dt><dd>{c.year}</dd></div>
      <div><dt>Scope</dt><dd>{c.scope}</dd></div>
      <div><dt>Status</dt><dd>{c.status} — <a href={c.link.href} target="_blank" rel="noopener">{c.link.label.toLowerCase()}</a></dd></div>
    </dl>
  </div></section>
  <section><div class="wrap"><div class="cshot"><Shot name={c.imgs[0]} alt={`${c.name} — home page`} eager /></div></div></section>
  <section><div class="wrap">
    <div class="ctext"><h2>The brief</h2><p>{c.brief}</p></div>
    <div class="ctext"><h2>What I did</h2><div><p>{c.did}</p><ul>{c.didList.map((x) => <li>{x}</li>)}</ul></div></div>
    <div class="cfacts">{c.facts.map(([a, b]) => <div class="cfact"><b>{a}</b><span>{b}</span></div>)}</div>
    <div class="cgal">
      <div class="cshot" data-clip><Shot name={c.imgs[1] ?? c.imgs[0]} alt={`${c.name} — inner page`} /></div>
      <div class="phone" data-parallax="0.08"><Shot name={c.mob} alt={`${c.name} on a phone`} widths={[390]} sizes="300px" /></div>
    </div>
    {c.imgs[2] && <div class="cshot" data-clip style="margin-bottom:clamp(64px,8vw,120px)"><Shot name={c.imgs[2]} alt={`${c.name} — story section`} /></div>}
  </div></section>
  <a class="next" href={u(`work/${next.slug}`)} data-cursor="Next"><div class="wrap"><small>Next project</small><p class="h1">{next.name}</p></div></a>
</Base>
