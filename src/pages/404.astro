---
import Base from '../layouts/Base.astro';
import Btn from '../components/Btn.astro';
import EagleStage from '../components/EagleStage.astro';
import { u } from '../data/site';
---
<Base title="Page not found — Saldr Studio" description="This page flew off.">
  <section class="phero"><div class="wrap founder">
    <div><h1 class="h1" data-split>This page flew off.</h1><p class="lead" data-fade style="margin-top:24px">The link may be old or mistyped. The rest of the site is right where you left it.</p><div style="margin-top:36px"><Btn label="Back to home" href={u('')} /></div></div>
    <div style="max-width:420px"><EagleStage labels={false} /></div>
  </div></section>
</Base>
